{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["build", "^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CLICKHOUSE_TEST_REQUIRED",
        "CLICKHOUSE_TEST_URL",
        "CLICKHOUSE_TEST_USER",
        "CLICKHOUSE_TEST_PASSWORD",
        "POSTGRES_TEST_REQUIRED",
        "POSTGRES_TEST_URL",
        "REDIS_TEST_REQUIRED",
        "REDIS_TEST_URL",
        "MAILPIT_TEST_REQUIRED",
        "MAILPIT_TEST_URL",
        "SMTP_TEST_URL",
        "WEB_HEADERS_TEST_REQUIRED",
        "DOCS_HEADERS_TEST_REQUIRED",
        "FUZZ_RUNS"
      ]
    }
  }
}
