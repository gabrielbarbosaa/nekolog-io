{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CLICKHOUSE_TEST_REQUIRED",
        "CLICKHOUSE_TEST_URL",
        "CLICKHOUSE_TEST_USER",
        "CLICKHOUSE_TEST_PASSWORD"
      ]
    }
  }
}
