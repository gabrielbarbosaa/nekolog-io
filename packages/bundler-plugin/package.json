{
  "name": "@nekolog-io/bundler-plugin",
  "version": "0.0.0",
  "description": "NekoLog bundler plugin: record the release and upload the source maps at the end of a production build, on Vite, webpack, Rollup and esbuild.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbarbosaa/nekolog-io.git",
    "directory": "packages/bundler-plugin"
  },
  "homepage": "https://nekolog.io",
  "bugs": "https://github.com/gabrielbarbosaa/nekolog-io/issues",
  "keywords": [
    "logging",
    "observability",
    "sourcemap",
    "unplugin",
    "vite",
    "webpack",
    "rollup",
    "esbuild",
    "nekolog"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.mts",
        "default": "./dist/rollup.mjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.mts",
        "default": "./dist/esbuild.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@nekolog-io/cli": "workspace:*",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "vitest": "^5.0.5"
  }
}
