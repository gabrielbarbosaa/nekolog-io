{
  "name": "@nekolog-io/browser",
  "version": "1.0.0",
  "description": "NekoLog SDK for the browser: global errors, session, setUser and a beacon flush on pagehide.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbarbosaa/nekolog-io.git",
    "directory": "packages/browser"
  },
  "homepage": "https://nekolog.io",
  "bugs": "https://github.com/gabrielbarbosaa/nekolog-io/issues",
  "keywords": [
    "logging",
    "logger",
    "observability",
    "browser",
    "nekolog"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "publint && attw --pack . && size-limit"
  },
  "dependencies": {
    "@nekolog-io/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.0.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "vitest": "^5.0.5"
  }
}
