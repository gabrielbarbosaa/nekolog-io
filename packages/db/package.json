{
  "name": "@nekolog-io/db",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres schema NekoLog's jobs and dashboard share: organizations, projects, environments, keys and the audit log.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbarbosaa/nekolog-io.git",
    "directory": "packages/db"
  },
  "homepage": "https://nekolog.io",
  "bugs": "https://github.com/gabrielbarbosaa/nekolog-io/issues",
  "keywords": [
    "logging",
