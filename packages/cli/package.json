{
  "name": "@nekolog-io/cli",
  "version": "1.0.0",
  "description": "NekoLog command line: nekolog init detects the framework, installs the SDK and writes the .env.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbarbosaa/nekolog-io.git",
    "directory": "packages/cli"
  },
  "homepage": "https://nekolog.io",
  "bugs": "https://github.com/gabrielbarbosaa/nekolog-io/issues",
  "keywords": [
    "logging",
    "logger",
    "observability",
    "cli",
    "nekolog"
  ],
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "nekolog": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nekolog-io/adapters": "workspace:*",
    "@types/node": "^24.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "vitest": "^5.0.5"
  }
}
