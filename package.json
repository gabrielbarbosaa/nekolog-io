{
  "name": "nekolog",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev:infra": "docker compose -f deploy/docker-compose.dev.yml --env-file .env up -d",
    "dev:infra:down": "docker compose -f deploy/docker-compose.dev.yml --env-file .env down",
    "dev:infra:logs": "docker compose -f deploy/docker-compose.dev.yml --env-file .env logs -f",
    "dev": "pnpm dev:infra && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "ch:migrate": "pnpm --filter @nekolog-io/clickhouse ch migrate",
    "ch:status": "pnpm --filter @nekolog-io/clickhouse ch status",
    "ch:new": "pnpm --filter @nekolog-io/clickhouse ch new",
    "db:generate": "pnpm --filter @nekolog-io/db db:generate",
    "db:migrate": "pnpm --filter @nekolog-io/db db:migrate",
    "load": "pnpm --filter @internal/load load",
    "release:sbom": "pnpm run sbom:write && pnpm run sbom:check",
    "sbom:write": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.7 --sbom-type library --sbom-supplier NekoLog --prod --lockfile-only --exclude-peers --split --filter \"@nekolog-io/*\" --out sbom/%s.cdx.json",
    "sbom:check": "pnpm --filter @internal/release sbom:check",
    "seed": "pnpm --filter @internal/seed seed",
    "tracking": "pnpm --filter @internal/tracking tracking",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/dev",
    "version-packages": "changeset version && pnpm run stamp-sdk-versions",
    "version-packages:dev": "changeset version --snapshot dev && pnpm run stamp-sdk-versions",
    "version-packages:next": "changeset version --snapshot next && pnpm run stamp-sdk-versions",
    "stamp-sdk-versions": "node internal/release/src/stamp-cli.ts",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "lefthook": "^2.1.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
