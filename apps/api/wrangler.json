{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nekolog-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "nekolog-api-dev",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true
      },
      "kv_namespaces": [
        {
          "binding": "KEYS",
          "id": "${KV_NAMESPACE_ID}"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SOURCEMAPS",
          "bucket_name": "${SOURCEMAPS_BUCKET}"
        }
      ],
      "vars": {
        "CLICKHOUSE_URL": "${CLICKHOUSE_URL}",
        "CLICKHOUSE_DB": "nekolog_dev",
        "API_VERSION": "${API_VERSION}"
      }
    },
    "qa": {
      "name": "nekolog-api-qa",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true
      },
      "kv_namespaces": [
        {
          "binding": "KEYS",
          "id": "${KV_NAMESPACE_ID}"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SOURCEMAPS",
          "bucket_name": "${SOURCEMAPS_BUCKET}"
        }
      ],
      "vars": {
        "CLICKHOUSE_URL": "${CLICKHOUSE_URL}",
        "CLICKHOUSE_DB": "nekolog_qa",
        "API_VERSION": "${API_VERSION}"
      }
    },
    "prod": {
      "name": "nekolog-api-prod",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true
      },
      "kv_namespaces": [
        {
          "binding": "KEYS",
          "id": "${KV_NAMESPACE_ID}"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SOURCEMAPS",
          "bucket_name": "${SOURCEMAPS_BUCKET}"
        }
      ],
      "vars": {
        "CLICKHOUSE_URL": "${CLICKHOUSE_URL}",
        "CLICKHOUSE_DB": "nekolog_prod",
        "API_VERSION": "${API_VERSION}"
      }
    }
  }
}
