<clickhouse>
  <profiles>
    <default>
      <max_memory_usage>858993459</max_memory_usage>
      <max_bytes_before_external_group_by>429496729</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>429496729</max_bytes_before_external_sort>
      <max_threads>2</max_threads>
      <max_execution_time>60</max_execution_time>
      <log_queries>0</log_queries>
    </default>
  </profiles>

  <users>
    <nekolog_reader>
      <password from_env="CLICKHOUSE_READ_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT ON nekolog.*</query>
      </grants>
    </nekolog_reader>

    <nekolog_ingest>
      <password from_env="CLICKHOUSE_INSERT_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT INSERT ON nekolog.logs</query>
        <query>GRANT SELECT(project_id, environment_id, timestamp, received_at, level, service) ON nekolog.logs</query>
      </grants>
    </nekolog_ingest>

    <nekolog_jobs>
      <password from_env="CLICKHOUSE_JOBS_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT, INSERT ON nekolog.*</query>
        <query>GRANT SELECT ON system.disks</query>
      </grants>
    </nekolog_jobs>

    <nekolog_backup>
      <password from_env="CLICKHOUSE_BACKUP_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT BACKUP ON nekolog.*</query>
        <query>GRANT WRITE ON S3</query>
        <query>GRANT SELECT ON system.backups</query>
      </grants>
    </nekolog_backup>

    <nekolog_migrator>
      <password from_env="CLICKHOUSE_MIGRATOR_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT, INSERT, CREATE, DROP, ALTER, TRUNCATE, SHOW ON nekolog.*</query>
      </grants>
    </nekolog_migrator>
  </users>
</clickhouse>
