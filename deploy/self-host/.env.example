# Copy this to .env next to it, or let ./up.sh write one with fresh secrets.
# Every value without a default below is required: the stack refuses to start
# without it rather than falling back to something guessable.

# openssl rand -hex 24
CLICKHOUSE_DEFAULT_PASSWORD=
CLICKHOUSE_READ_PASSWORD=
CLICKHOUSE_INSERT_PASSWORD=
CLICKHOUSE_JOBS_PASSWORD=
CLICKHOUSE_BACKUP_PASSWORD=
CLICKHOUSE_MIGRATOR_PASSWORD=
POSTGRES_PASSWORD=

# openssl rand -hex 32 — exactly 32 bytes, because it is the AES-256-GCM key
# that seals every alert channel secret. Losing it means every channel has to
# be configured again; changing it means running resealChannelSecrets first.
ENCRYPTION_KEY=

# The address an alert links to, as <this>/explorer?env=...
# NekoLog's dashboard is closed-source and cloud-only, so self-host ships none:
# point this at whatever you actually use to read logs. It only ever becomes a
# link inside an alert — nothing calls it.
NEKOLOG_CONSOLE_URL=https://localhost

# The domain the proxy answers on. It serves ingest.<this> and api.<this> and
# gets a certificate for both from Let's Encrypt. Leave it as localhost and
# Caddy issues its own certificate instead, which is what local testing wants.
NEKOLOG_DOMAIN=localhost

# Where Let's Encrypt sends expiry warnings. Unused while the domain is
# localhost, required all the same, because a certificate that silently stops
# renewing is how a platform goes dark on a Sunday.
ACME_EMAIL=admin@localhost

# The ports the proxy publishes. Everything from the outside arrives here.
HTTP_PUBLISH=80
HTTPS_PUBLISH=443

# The loopback port the ingestion answers on, behind the proxy. It speaks
# plain HTTP and is not reachable from outside the machine.
INGEST_PUBLISH=8787

# The loopback port the jobs health endpoint answers on.
JOBS_PUBLISH=8788

# The loopback port the public read API answers on, behind the proxy.
API_PUBLISH=8789

# How much memory each container may take. The defaults are sized for the
# smallest machine worth running this on: 4 GB total. ClickHouse's own ceiling
# in clickhouse-limits.xml is deliberately lower than its container limit, so a
# query that asks for too much is refused rather than the process being killed.
CLICKHOUSE_MEM_LIMIT=1800m
POSTGRES_MEM_LIMIT=512m
APP_MEM_LIMIT=256m
PROXY_MEM_LIMIT=128m
WEB_MEM_LIMIT=384m
DOCS_MEM_LIMIT=64m

# Per-isolate burst brake on the read API, in requests per minute and per key.
API_REQUESTS_PER_MINUTE=120

# Source maps live in a Docker volume of their own, written only by the api
# container. On the hosted service this is an R2 bucket; here it is a directory,
# because the application receives the bytes itself and a BlobStore does not
# care which it is. The path is set in the compose file, not here.

# The first project's environments and how long their logs are kept.
SEED_ENVIRONMENTS=production
SEED_RETENTION_DAYS=30

# Per-isolate burst brake on the ingestion, in events per minute.
INGEST_EVENTS_PER_MINUTE=2000

# Optional. The daily per-environment event quota the jobs container enforces.
DAILY_EVENT_QUOTA=

# Optional. Where the platform's own trouble is reported: a disk filling up, a
# spool that will not drain, an environment blocked for going over quota.
OPS_DISCORD_WEBHOOK_URL=

# Optional. Pinged after every successful run, and at <this>/fail after a
# failed one, so a dead cron and a broken task are different signals.
HEARTBEAT_URL=

# Where ClickHouse writes its daily backup. Leave these empty and there is no
# backup of the logs at all: every event on this machine exists in exactly one
# place, and the jobs container says so on every start.
#
# It must be an object store somewhere else. A backup on this disk is not a
# backup — it dies with the disk. Any S3-compatible bucket works; Cloudflare R2
# has a free tier that fits a small instance.
#
# Nothing here deletes an old backup, because ClickHouse cannot. Put a lifecycle
# rule on the bucket, or it grows forever.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# The Postgres goes to the same bucket, through `pg_dump | gzip | age` in one
# pipe, so no readable .sql is ever written. This is the **public** half of an
# age key pair; keep the private half off this machine, or an attacker who
# reaches the bucket and the server reaches the backups too.
#
#   age-keygen -o identity.key       # the private half: store it offline
#   age-keygen -y identity.key       # the public half: paste it below
#
# Leave it empty and the Postgres is not backed up, and the container says so.
BACKUP_AGE_RECIPIENT=

# Which environment the Postgres backup is named after, and how long one is
# kept. Nothing deletes a backup on a day it failed to make one.
BACKUP_ENVIRONMENT=prod
BACKUP_KEEP_DAYS=30
