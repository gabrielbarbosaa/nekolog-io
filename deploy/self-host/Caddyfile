{
	email {$ACME_EMAIL}
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

ingest.{$NEKOLOG_DOMAIN} {
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy ingest:8787
}

api.{$NEKOLOG_DOMAIN} {
	encode gzip
	reverse_proxy api:8789
}

{$NEKOLOG_DOMAIN} {
	encode gzip

	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy docs:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
