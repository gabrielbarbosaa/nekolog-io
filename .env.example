# `pnpm dev` copies this file to .env, keeps every value you had already set,
# and replaces each `dev-only-fake-…` placeholder with a real generated one.
# See docs/ESPECIFICACOES.md spec 2 for what each variable is for.

# --- deploy/docker-compose.dev.yml -----------------------------------------
# Provisions the local Postgres, ClickHouse, and Garage containers. The
# app-facing variables below point at these same containers.
POSTGRES_USER=nekolog
POSTGRES_PASSWORD=nekolog
POSTGRES_DB=nekolog_dev
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=nekolog
GARAGE_ADMIN_TOKEN=dev-admin-token

# --- Shared -------------------------------------------------------------
APP_ENV=dev

# --- Dashboard (apps/dashboard, :3001) -----------------------------------
# APP_URL is the dashboard's own address, not the landing page's. The proxy
# compares it against the Origin of anything that writes, so pointing it at
# :3000 refuses every form on the dashboard with bad_origin.
APP_URL=http://localhost:3001
DATABASE_URL=postgres://nekolog:nekolog@localhost:5432/nekolog_dev

# Self-host Redis (use UPSTASH_REDIS_REST_URL/_TOKEN instead for the cloud)
REDIS_URL=redis://localhost:6379

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=nekolog_dev
CLICKHOUSE_READ_USER=nekolog_reader
CLICKHOUSE_READ_PASSWORD=nekolog

# Only needed when ClickHouse sits behind Cloudflare Access (not for local dev)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_KV_API_TOKEN=

# Self-host blob storage via Garage (S3-compatible). garage-init imports these
# exact credentials, so changing them here changes what the container accepts.
R2_ENDPOINT=http://localhost:3900
R2_REGION=us-east-1
R2_BUCKET=nekolog-dev
R2_ACCESS_KEY_ID=GK31c2f218a2e44f485b94239e
R2_SECRET_ACCESS_KEY=b0e7a4c21d8f5639ae0c47b2f81d3a6950c8e2b47f1a9d3c6e05b8a2f47c91d3

# Generate a real pair with: openssl genpkey -algorithm Ed25519
AUTH_JWT_PRIVATE_KEY=dev-only-fake-ed25519-private-key
AUTH_JWT_PUBLIC_KEY=dev-only-fake-ed25519-public-key
AUTH_OTP_SECRET=dev-only-fake-otp-secret
# Generate a real key with: openssl rand -base64 32
ENCRYPTION_KEY=dev-only-fake-encryption-key

# Self-host mail via Mailpit (use RESEND_API_KEY instead for the cloud)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@nekolog.test

# Outside APP_ENV=prod nothing is sent to an address that is not on this list,
# and **an empty list allows nobody** — a missing variable is a fresh machine,
# not permission to write to strangers. In dev that is the difference between
# getting a sign-in code and never being able to log in, so add your own domain
# here. An entry matches an address exactly, or a whole domain with a leading @.
EMAIL_ALLOWLIST=@acme.test,@nekolog.test,@example.test

# Turnstile is off while TURNSTILE_SECRET_KEY is empty, and that is what dev
# wants: setting it turns the check on for sign-up, sign-in and password
# recovery, and nothing here renders the widget, so every one of them would
# answer challenge_failed. Cloudflare's published always-pass test pair, for
# when you do want to exercise it:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEKOLOG_SELF_KEY=dev-only-fake-self-key

# --- Ingestion (apps/ingest) ----------------------------------------------
# CLICKHOUSE_URL and CLICKHOUSE_DB are shared with the dashboard above.
CLICKHOUSE_INSERT_USER=nekolog_ingest
CLICKHOUSE_INSERT_PASSWORD=nekolog

# Burst brake per environment, counted per Worker instance. Leave it unset to
# use the shipped default. The daily quota below is the real cap.
INGEST_EVENTS_PER_MINUTE=

# `pnpm --filter @apps/ingest serve` reads the keys from this file, which
# `pnpm seed init` writes. The path is relative to the repository root.
INGEST_SEED_FILE=.nekolog-seed.json

# Every app reports its version on /health. `pnpm dev:doctor` uses this to tell
# the process you just started apart from a self-host container left running on
# the same port: the two stacks both want 8787, 8788 and 8789.
INGEST_VERSION=dev
JOBS_VERSION=dev
API_VERSION=dev

# --- Examples (examples/express) ------------------------------------------
# Paste a key printed by `pnpm seed init`. With NEKOLOG_KEY empty the SDK
# falls back to the console sink, so the example still runs.
NEKOLOG_KEY=
NEKOLOG_ENDPOINT=http://127.0.0.1:8787
NEKOLOG_SERVICE=example-express

# --- Jobs (apps/jobs, :8788) -----------------------------------------------
CLICKHOUSE_JOBS_USER=nekolog_jobs
CLICKHOUSE_JOBS_PASSWORD=nekolog

# The two directories the ingestion and the jobs share, standing in for R2 and
# Workers KV. `key-sync` publishes the API keys into KV_DIR once a minute and
# the ingestion reads them from there, so a key minted in the dashboard needs
# the jobs running to work at all.
SPOOL_DIR=.nekolog-dev/spool
KV_DIR=.nekolog-dev/kv

# Where the jobs link to in the e-mails they send.
NEKOLOG_CONSOLE_URL=http://localhost:3001

# --- Public read API (apps/api, :8789) --------------------------------------
API_PORT=8789

# Events per environment per UTC day. Leave it unset to use the shipped
# default. Going over writes a block into KV, which the ingestion reads.
DAILY_EVENT_QUOTA=
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/dev-only-fake
OPS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/dev-only/fake

# --- ClickHouse migrations (packages/clickhouse) ---------------------------
# Needs DDL rights. In the hosted setup this is a CI-only credential.
CLICKHOUSE_MIGRATOR_USER=nekolog_migrator
CLICKHOUSE_MIGRATOR_PASSWORD=nekolog

# --- Export round trip (packages/clickhouse) -------------------------------
# The export writes through ClickHouse's s3() function, so the endpoint has to
# be one ClickHouse itself can reach: inside the dev stack that is the compose
# service name, not localhost. Without these three the statement is still tested
# against ClickHouse and only the write to the object store is skipped.
EXPORT_S3_TEST_ENDPOINT=http://garage:3900/nekolog-dev
EXPORT_S3_TEST_ACCESS_KEY=GK31c2f218a2e44f485b94239e
EXPORT_S3_TEST_SECRET=b0e7a4c21d8f5639ae0c47b2f81d3a6950c8e2b47f1a9d3c6e05b8a2f47c91d3
